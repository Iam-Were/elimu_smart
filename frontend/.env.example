# Parse Server Configuration
VITE_PARSE_APP_ID=elimu-smart-local-dev
VITE_PARSE_JS_KEY=elimu-smart-js-key-dev
VITE_PARSE_SERVER_URL=http://localhost:1337/parse

# Environment identifier (development, staging, production)
VITE_ENV=development

# Environment-Specific Configuration:
# ---------------------------------
# Local Development (.env):
#   VITE_PARSE_SERVER_URL=http://localhost:1337/parse
#   VITE_ENV=development
#
# Staging (.env.staging):
#   VITE_PARSE_SERVER_URL=https://staging.elimu-smart.co.ke/parse
#   VITE_ENV=staging
#
# Production (.env.production):
#   VITE_PARSE_SERVER_URL=https://elimu-smart.co.ke/parse
#   VITE_ENV=production
#
# Build Commands:
# - Development: npm run dev (uses .env)
# - Staging: npm run build -- --mode staging (uses .env.staging)
# - Production: npm run build -- --mode production (uses .env.production)
#
# Notes:
# - Copy this file to .env for local development
# - Never commit actual API keys or .env files to version control
# - .env.local overrides .env for local customization (gitignored)
