# Elimu Smart Production Environment Variables
# Copy this file to .env.production and fill in real values

# Database Configuration
DATABASE_URI=postgres://elimu:CHANGE_ME@localhost:5432/elimu_smart_prod
DB_PASSWORD=CHANGE_ME

# Parse Server Configuration
APP_ID=elimu_smart_app_2024
MASTER_KEY=CHANGE_ME
SERVER_URL=https://elimu-smart.co.ke/parse
PUBLIC_SERVER_URL=https://elimu-smart.co.ke/parse

# Server Configuration
PORT=1337
NODE_ENV=production
LOG_LEVEL=info

# Dashboard Configuration
DASHBOARD_USER=admin
DASHBOARD_PASS=CHANGE_ME

# Redis Cache Configuration
REDIS_URL=redis://localhost:6379
CACHE_TTL_DASHBOARD=300
CACHE_TTL_ASSESSMENTS=3600
CACHE_TTL_CAREERS=86400

# Email Configuration (ZeptoMail)
ZEPTOMAIL_API_URL=https://api.zeptomail.com/v1.1/email
ZEPTOMAIL_TOKEN=CHANGE_ME
ZEPTOMAIL_FROM_EMAIL=noreply@elimu-smart.co.ke
ZEPTOMAIL_FROM_NAME=Elimu Smart Platform

# M-Pesa Production Configuration
MPESA_ENVIRONMENT=production
MPESA_CONSUMER_KEY=CHANGE_ME
MPESA_CONSUMER_SECRET=CHANGE_ME
MPESA_SHORTCODE=CHANGE_ME
MPESA_PASSKEY=CHANGE_ME
MPESA_CALLBACK_URL=https://elimu-smart.co.ke/api/mpesa-callback.php
MPESA_TIMEOUT_URL=https://elimu-smart.co.ke/api/mpesa-timeout.php

# Parse Platform Production Settings
PARSE_APP_ID_PRODUCTION=elimu_smart_app_2024
PARSE_MASTER_KEY_PRODUCTION=CHANGE_ME
PARSE_SERVER_URL_PRODUCTION=https://elimu-smart.co.ke/parse

# Session Configuration
SESSION_LENGTH=31536000

# File Upload Configuration
MAX_UPLOAD_SIZE=10485760

# Rate Limiting
RATE_LIMIT_ENABLED=true
RATE_LIMIT_REQUESTS_PER_MINUTE=100

# CORS Configuration
ALLOWED_ORIGINS=https://elimu-smart.co.ke,https://www.elimu-smart.co.ke

# Backblaze B2 Backups (optional)
B2_APPLICATION_KEY_ID=
B2_APPLICATION_KEY=
B2_BUCKET_NAME=elimu-smart-backups

# Monitoring (optional)
SENTRY_DSN=
PM2_PUBLIC_KEY=
PM2_SECRET_KEY=
